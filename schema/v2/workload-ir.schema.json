{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workload-ir.schema.json",
  "title": "Realized serving iteration contract",
  "description": "Immutable workload facts copied from the measured profile so simulation cannot silently substitute a generic shape or scheduler state.",
  "type": "object",
  "required": ["schema_version", "phase", "execution_parameters", "workload", "fingerprint"],
  "properties": {
    "schema_version": {"const": "workload-ir.v1"},
    "profile_id": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "generation_mode": {"type": ["string", "null"]},
    "cuda_graph": {},
    "execution_parameters": {"type": "object"},
    "workload": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
