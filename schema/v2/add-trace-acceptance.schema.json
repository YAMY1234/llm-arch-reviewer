{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "add-trace-acceptance.schema.json",
  "title": "llm-arch-reviewer deterministic add-trace acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "model_id", "model_revision", "semantic_revision", "model_ir_sha256", "execution_path_id", "execution_fingerprint", "binding_revision_id", "manifest_sha256", "plan_sha256", "binding_revision_sha256", "eager_reconciliation_sha256", "trace_attribution_sha256", "runtime_identity_sha256", "runtime_evidence_sha256", "mapping_rules_sha256", "eager_protocol_sha256", "production_protocol_sha256", "window_selection_sha256", "production_captured_at", "rank_count", "eager_rule_count", "eager_event_count", "eager_duration_us", "production_event_count", "production_duration_us", "status", "acceptance_sha256"],
  "properties": {
    "schema_version": {"const": "add-trace-acceptance.v1"},
    "run_id": {"type": "string"},
    "model_id": {"type": "string"},
    "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semantic_revision": {"type": ["integer", "string"]},
    "model_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_path_id": {"type": "string"},
    "execution_fingerprint": {"type": "string", "pattern": "^exec_[0-9a-f]{16}$"},
    "binding_revision_id": {"type": "string", "pattern": "^bind_[0-9a-f]{16}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eager_reconciliation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace_attribution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping_rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eager_protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production_protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "window_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production_captured_at": {"type": "string", "format": "date-time"},
    "rank_count": {"type": "integer", "minimum": 1},
    "eager_rule_count": {"type": "integer", "minimum": 1},
    "eager_event_count": {"type": "integer", "minimum": 1},
    "eager_duration_us": {"type": "number", "exclusiveMinimum": 0},
    "production_event_count": {"type": "integer", "minimum": 1},
    "production_duration_us": {"type": "number", "exclusiveMinimum": 0},
    "status": {"const": "pass"},
    "acceptance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
