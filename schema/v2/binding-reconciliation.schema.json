{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "binding-reconciliation.schema.json",
  "title": "graph-off eager binding reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "model_id", "execution_path_id",
    "execution_fingerprint", "binding_revision_id", "plan_sha256", "status",
    "cuda_graph_enabled", "protocol_artifact", "rank_artifacts", "rule_results", "support_events",
    "coverage",
    "unresolved", "discrepancies"
  ],
  "properties": {
    "schema_version": {"const": "binding-reconciliation.v1"},
    "run_id": {"type": "string"},
    "model_id": {"type": "string"},
    "execution_path_id": {"type": "string"},
    "execution_fingerprint": {"type": "string", "pattern": "^exec_[0-9a-f]{16}$"},
    "binding_revision_id": {"type": "string", "pattern": "^bind_[0-9a-f]{16}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "fail"]},
    "cuda_graph_enabled": {"const": false},
    "protocol_artifact": {"$ref": "trace-attribution.schema.json#/$defs/artifact"},
    "rank_artifacts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "trace-attribution.schema.json#/$defs/rank_artifact"}
    },
    "rule_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "ir_target", "rank", "eager_event_ids", "duration_us", "matched_evidence", "status"],
        "properties": {
          "rule_id": {"type": "string"},
          "ir_target": {"type": "string"},
          "rank": {"type": "integer", "minimum": 0},
          "eager_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "duration_us": {"type": "number", "exclusiveMinimum": 0},
          "matched_evidence": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "python_stack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_symbol": {"type": "string", "minLength": 1},
              "operator_sequence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "collective_signature": {"type": "string", "minLength": 1},
              "state_transition": {"type": "string", "minLength": 1}
            }
          },
          "status": {"const": "pass"},
          "observed_shape": {"type": "string"},
          "observed_dtype": {"type": "string"},
          "stack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "support_events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "rank", "support_class", "support_reason", "duration_us"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 0},
          "support_class": {"enum": ["cuda_runtime", "collective_runtime", "memory_management", "sampling_runtime", "profiler_overhead", "framework_runtime"]},
          "support_reason": {"type": "string", "minLength": 1},
          "duration_us": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["event_count_total", "event_count_accounted", "duration_us_total", "duration_us_accounted"],
      "properties": {
        "event_count_total": {"type": "integer", "minimum": 1},
        "event_count_accounted": {"type": "integer", "minimum": 1},
        "duration_us_total": {"type": "number", "exclusiveMinimum": 0},
        "duration_us_accounted": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "unresolved": {"type": "array", "maxItems": 0},
    "discrepancies": {"type": "array", "maxItems": 0}
  }
}
