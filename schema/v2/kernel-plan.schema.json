{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel-plan.schema.json",
  "title": "Versioned implementation kernel-plan identity",
  "description": "Names the concrete algorithmic plan calibrated by a projection surface. It is implementation evidence, not Model IR.",
  "type": "object",
  "required": ["schema_version", "plan_id", "source", "algorithm"],
  "properties": {
    "schema_version": {"const": "kernel-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
    "source": {"enum": ["code_review", "eager_trace", "cuda_graph_trace", "microbenchmark", "external_simulator"]},
    "algorithm": {"type": "string"},
    "dtype": {"type": "string"},
    "tile": {"type": "object"},
    "launches": {"type": "array", "items": {"type": "object"}},
    "sync_events": {"type": "array", "items": {"type": "object"}},
    "fusion_scope": {"type": "array", "items": {"type": "string"}},
    "cache_reuse": {"type": "object"},
    "persistent_schedule": {"type": "object"},
    "evidence": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
