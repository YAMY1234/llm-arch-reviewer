{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-binding.schema.json",
  "title": "llm-arch-reviewer implementation binding",
  "type": "object",
  "required": ["schema_version", "implementation_id", "label", "model_id", "execution_path_id", "source_repo", "source_commit", "node_bindings"],
  "properties": {
    "schema_version": {"const": "implementation-binding.v2"},
    "implementation_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
    "label": {"type": "string"},
    "model_id": {"type": "string"},
    "execution_path_id": {"type": "string"},
    "framework_id": {
      "description": "Canonical compiler/viewer framework identity. Required as an authored override when source_repo is not a known canonical repository.",
      "enum": ["sglang", "vllm", "tensorrt_llm"]
    },
    "source_repo": {"type": "string", "format": "uri"},
    "source_commit": {"type": ["string", "integer"]},
    "source_patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "container": {"type": "string"},
    "backend": {"type": "string"},
    "binding_status": {
      "type": "string",
      "enum": ["draft", "validated", "unsupported"],
      "description": "Lifecycle state. A source-derived binding remains draft until the candidate Execution IR passes the required eager semantic run."
    },
    "source_lock_status": {
      "type": "string",
      "enum": ["provisional", "runtime_verified", "mismatch"],
      "description": "Whether the running container was verified against source_commit."
    },
    "execution_validation": {
      "type": "object",
      "required": ["status", "execution_fingerprint", "required_phases", "cuda_graph_enabled"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "pass", "fail", "unsupported"]
        },
        "execution_fingerprint": {
          "type": "string",
          "pattern": "^exec_[0-9a-f]{16}$"
        },
        "required_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["prefill", "decode"]}
        },
        "cuda_graph_enabled": {"const": false},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "description": "Implementation whose source bindings are reused on matching nodes before local overrides are applied."
    },
    "binding_compatible_base_commit": {
      "type": ["string", "integer"],
      "description": "Explicitly names the base source commit whose semantic/operator bindings remain valid when the child source_commit differs."
    },
    "binding_revision_id": {
      "type": "string",
      "pattern": "^bind_[0-9a-f]{16}$"
    },
    "add_trace_acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Content digest of the passing add-trace acceptance artifact that authorized catalog materialization."
    },
    "runtime_identity": {
      "$ref": "binding-revision.schema.json#/$defs/runtime_identity"
    },
    "runtime_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "trace-attribution.schema.json#/$defs/artifact"}
    },
    "mapping_rules_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_rules": {
      "type": "array",
      "items": {"$ref": "binding-revision.schema.json#/$defs/mapping_rule"}
    },
    "node_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "symbols": {"type": "array", "items": {"type": "string"}},
          "kernel_signatures": {"type": "array", "items": {"type": "string"}},
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "symbol"],
              "properties": {
                "file": {"type": "string"},
                "symbol": {"type": "string"},
                "line": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "display": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
