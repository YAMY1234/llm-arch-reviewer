{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "llm-arch-reviewer profile overlay",
  "type": "object",
  "required": ["schema_version", "profile_id", "label", "model_id", "execution_path_id", "implementation_id", "variant_id", "phase", "execution_parameters", "node_metrics"],
  "properties": {
    "schema_version": {"const": "profile.v2"},
    "profile_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
    "label": {"type": "string"},
    "model_id": {"type": "string"},
    "execution_path_id": {"type": "string"},
    "implementation_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "phase": {"type": "string"},
    "generation_mode": {
      "description": "Orthogonal generation/control-flow mode. It does not change the target model or parallel execution topology.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "default": "autoregressive"
    },
    "entry_view": {
      "description": "Stable semantic view to open when this profile is selected.",
      "type": "string",
      "minLength": 1
    },
    "execution_parameters": {
      "type": "object",
      "required": ["tp_size", "dp_size", "cp_size", "ep_size"],
      "properties": {
        "tp_size": {"type": "integer", "minimum": 1},
        "dp_size": {"type": "integer", "minimum": 1},
        "cp_size": {"type": "integer", "minimum": 1},
        "ep_size": {"type": "integer", "minimum": 1}
      }
    },
    "hardware": {"type": "object"},
    "workload": {"type": "object"},
    "profiler": {"type": "object"},
    "evidence": {"type": "object"},
    "timeline": {
      "type": "object",
      "required": ["schema_version", "artifact", "sha256", "reference_rank", "step_count", "event_count"],
      "properties": {
        "schema_version": {"const": "timeline.v1"},
        "artifact": {"type": "string", "pattern": "^[^/\\\\]+\\.timeline\\.json\\.gz$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_rank": {"type": "integer", "minimum": 0},
        "step_count": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 0},
        "raw_trace_file": {"type": "string"}
      },
      "additionalProperties": true
    },
    "node_states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string"},
          "label": {"type": "string"},
          "included_in": {"type": "string"},
          "fusion_group_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "fusion_groups": {
      "description": "Compiled or authored implementation-specific fused-kernel coverage. Shared intervals must not be summed once per covered IR node.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["owner", "ir_nodes", "timing_semantics"],
        "properties": {
          "owner": {"type": "string"},
          "ir_nodes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "timing_semantics": {"const": "shared_interval"},
          "provenance": {"type": "string"}
        }
      }
    },
    "node_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ms_per_iter"],
        "properties": {
          "ms_per_iter": {"type": "number", "minimum": 0},
          "kernels": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
