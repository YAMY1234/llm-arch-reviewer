{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "llm-arch-reviewer profile overlay",
  "type": "object",
  "required": ["schema_version", "profile_id", "label", "model_id", "execution_path_id", "implementation_id", "variant_id", "phase", "execution_parameters", "node_metrics"],
  "properties": {
    "schema_version": {"const": "profile.v2"},
    "profile_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
    "label": {"type": "string"},
    "model_id": {"type": "string"},
    "execution_path_id": {"type": "string"},
    "implementation_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "phase": {"type": "string"},
    "generation_mode": {
      "description": "Orthogonal generation/control-flow mode. It does not change the target model or parallel execution topology.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "default": "autoregressive"
    },
    "comparison_variant": {
      "description": "Explicit framework-neutral discriminator for semantically different model paths at an otherwise identical workload (for example, a feature-disabled baseline). Never inferred from profile_id.",
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$",
      "default": "production_default"
    },
    "formal_step_semantics": {"type": "string", "minLength": 1},
    "dtype": {"type": "string", "minLength": 1},
    "quantization": {"type": "string", "minLength": 1},
    "comparison_config": {
      "description": "Authored backend-significant model configuration included in comparison-contract.v1.",
      "type": "object"
    },
    "scheduler_contract": {
      "description": "Normalized scheduler behavior that changes the executed formal workload.",
      "type": ["string", "object"]
    },
    "entry_view": {
      "description": "Stable semantic view to open when this profile is selected.",
      "type": "string",
      "minLength": 1
    },
    "execution_parameters": {
      "type": "object",
      "required": ["tp_size", "dp_size", "cp_size", "ep_size"],
      "properties": {
        "tp_size": {"type": "integer", "minimum": 1},
        "dp_size": {"type": "integer", "minimum": 1},
        "cp_size": {"type": "integer", "minimum": 1},
        "ep_size": {"type": "integer", "minimum": 1}
      }
    },
    "hardware": {"type": "object"},
    "workload": {"type": "object"},
    "profiler": {"type": "object"},
    "evidence": {"type": "object"},
    "timeline": {
      "type": "object",
      "required": ["schema_version", "artifact", "sha256", "reference_rank", "step_count", "event_count"],
      "properties": {
        "schema_version": {"const": "timeline.v1"},
        "artifact": {"type": "string", "pattern": "^[^/\\\\]+\\.timeline\\.json\\.gz$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_rank": {"type": "integer", "minimum": 0},
        "step_count": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 0},
        "raw_trace_file": {"type": "string"}
      },
      "additionalProperties": true
    },
    "node_states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string"},
          "label": {"type": "string"},
          "included_in": {"type": "string"},
          "fusion_group_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "fusion_groups": {
      "description": "Compiled or authored implementation-specific fused-kernel coverage. Shared intervals must not be summed once per covered IR node.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["owner", "ir_nodes", "timing_semantics"],
        "properties": {
          "owner": {"type": "string"},
          "ir_nodes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "timing_semantics": {
            "enum": ["shared_interval", "shared_event_set"],
            "description": "shared_interval is one production interval; shared_event_set is a validated aggregate of multiple production intervals. Covered IR nodes never receive additive copies of either value."
          },
          "provenance": {"type": "string"},
          "mapping_method": {"type": "string"},
          "confidence": {"enum": ["exact", "high", "medium", "low", "review_required"]},
          "evidence_scope": {
            "description": "Occurrence scope and eager/production event closure proving the many-to-many fusion relation.",
            "type": "object",
            "required": ["resolution"],
            "properties": {
              "resolution": {"enum": ["exact_occurrence", "profile_aggregate"]},
              "layer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
              "substages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "occurrence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "production_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "eager_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      }
    },
    "node_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ms_per_iter"],
        "properties": {
          "ms_per_iter": {"type": "number", "minimum": 0},
          "kernels": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
