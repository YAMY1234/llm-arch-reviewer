{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gap-report.schema.json",
  "title": "llm-arch-reviewer measured-versus-SoL gap report",
  "type": "object",
  "required": ["schema_version", "gap_report_id", "sol_profile_id", "model_id", "execution_fingerprint", "measured_profile_id", "hardware_spec_id", "status", "coverage", "model_violations", "nodes", "provenance"],
  "properties": {
    "schema_version": {"const": "gap-report.v1"},
    "gap_report_id": {"type": "string"},
    "status": {"enum": ["invalid_sol_model", "invalid_projection_model", "partial_calibration", "ready"]},
    "model_violations": {"type": "array", "items": {"type": "string"}},
    "projection_violations": {"type": "array", "items": {"type": "string"}},
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "methodology_optimistic_coverage_pct": {"type": ["number", "null"], "minimum": 0},
          "methodology_conservative_coverage_pct": {"type": ["number", "null"], "minimum": 0},
          "methodology_gap_range_ms": {"type": ["object", "null"]},
          "attainable_coverage_pct": {"type": ["number", "null"], "minimum": 0},
          "attainable_interval_ms": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
